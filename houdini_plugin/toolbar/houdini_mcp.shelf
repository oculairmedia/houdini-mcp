<shelfDocument>
  <!-- Houdini MCP Shelf -->
  <toolshelf name="houdini_mcp" label="Houdini MCP">
    <memberTool name="mcp_start"/>
    <memberTool name="mcp_stop"/>
    <memberTool name="mcp_status"/>
    <memberTool name="hrpyc_start"/>
    <memberTool name="hrpyc_stop"/>
